--enable faillock # pam-auth-update --enable faillock_notify Internal Only - General Note: - The name used for the file must be used in the pam-auth-update --enable command - The Name: line should be easily recognizable and understood - The Priority: Line is important as it effects the order of the lines in the - /etc/pam.d/ files If a site specific custom profile is being used in your environment to configure PAM that includes the configuration for the pam_faillock module, enable that module instead.","compliance":{"cis":"5.3.2.2","cis_csc_v8":"6.2","cis_csc_v7":"16.7","cmmc_v2.0":"AC.L1-3.1.1","hipaa":"164.308(a)(3)(ii)(C)","iso_27001-2013":"A.9.2.6","mitre_mitigations":"M1027","mitre_tactics":"TA0006","mitre_techniques":"T1110,T1110.001,T1110.003","nist_sp_800-53":"AC-2(1)","pci_dss_v3.2.1":"8.1.3","pci_dss_v4.0":"8.2.4,8.2.5","soc_2":"CC6.2,CC6.3"},"rules":["f:/etc/pam.d/common-auth -> r:pam_faillock.so","f:/etc/pam.d/common-account -> r:pam_faillock.so","f:/etc/pam.d/common-auth -> r:pam_faillock.so"],"condition":"all","file":"/etc/pam.d/common-auth","result":"failed"}}
